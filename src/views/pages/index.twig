{% extends "layouts.master" %}

{% block head_scripts %}
    <script defer src="{{ 'home.js'|asset }}"></script>
{% endblock %}

{% block header %}
    {# على الغلاف لا رأس: الغلاف صفحة دخول لا صفحة متجر #}
    {% if not theme.settings.get('bs_landing_enabled', true) %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block content %}
{% set land   = theme.settings.get('bs_landing_enabled', true) %}
{# افتراضي مدمج: الثيم يبدو كاملا قبل ان يضبط التاجر شيئا #}
{% set img1   = theme.settings.get('bs_landing_image_1') ?: 'images/cover-1.jpg'|asset %}
{% set img2   = theme.settings.get('bs_landing_image_2') ?: 'images/cover-2.jpg'|asset %}
{% set t1     = theme.settings.get('bs_landing_title', 'اصالة تلبس') %}
{% set t2     = theme.settings.get('bs_landing_title_2', 'وفخامة تورث') %}
{% set sub    = theme.settings.get('bs_landing_sub') %}

{% if land %}
{# ══════════ الغلاف ══════════ #}
<section class="bs-land" data-land data-testid="store-landing">
    <div class="bs-land__media" data-slides>
        <img class="is-on" src="{{ img1 }}" alt="{{ store.name }}" fetchpriority="high">
        {% if img2 %}<img src="{{ img2 }}" alt="{{ store.name }}" loading="lazy">{% endif %}
    </div>

    {# الشمس تمر مرة واحدة، والالواح ترتفع كما تُرفع طبقات القماش #}
    <div class="bs-sun" aria-hidden="true"></div>
    <div class="bs-reveal" aria-hidden="true">
        <b></b><b></b><b></b><b></b><b></b><b></b><b></b>
    </div>

    <div class="bs-land__body">
        <p class="bs-eyebrow">{{ store.name }}{% if store.slogan %} · {{ store.slogan }}{% endif %}</p>
        <h1 class="bs-land__h">{{ t1 }}<em>{{ t2 }}</em></h1>
        {% if sub %}<p class="bs-land__p">{{ sub }}</p>{% endif %}

        <a href="{{ store.url }}#bs-sections" class="bs-btn" data-land-enter style="margin-block-start:2.6rem;width:fit-content">
            {{ trans('bisht.enter_store') }}
            <i>{% include 'components.icons.door' %}</i>
        </a>
    </div>

    {% if img2 %}
        <div class="bs-dots" role="group" aria-label="{{ trans('bisht.cover') }}">
            <button data-slide-dot="0" aria-pressed="true"></button>
            <button data-slide-dot="1" aria-pressed="false"></button>
        </div>
    {% endif %}

    <div class="bs-land__foot">
        <span>{{ trans('bisht.bespoke') }}</span>
        {% if store.contacts.whatsapp %}<span>{{ trans('bisht.bespoke_cta') }}</span>{% endif %}
    </div>
</section>
{% endif %}

{#
  الاقسام صارت مكوّنا (‎home.main-links‎) لان سلة تغذّي التصنيفات لكل مكوّن
  بحسب مساره ولا تمرّرها الى الصفحة. المكوّن يُدرج تلقائيا لانه ‎is_default‎،
  ويرندر مع بقية عناصر التاجر في الحلقة اسفل الصفحة.
#}

{# ══════════ المناسبات ══════════ #}
{% if theme.settings.get('bs_occasions_enabled', true) %}
<section class="bs-col bs-pad" data-testid="store-occasions">
    <div class="bs-col__head bs-rise">
        <h2>{{ trans('bisht.occasions') }}</h2>
        <span>{{ trans('bisht.size_guide') }}</span>
    </div>
    <bisht-products source="latest" limit="4" data-testid="store-occasions-list"></bisht-products>
</section>
{% endif %}

{# ══════════ عناصر التاجر القابلة للتخصيص ══════════ #}
{% for component in page.components %}
    {{ component.render() }}
{% endfor %}
{% endblock %}
