{#
  خيارات المنتج — يرندرها مكوّن سلة ‎<salla-product-options>‎ (شرط المراجعة)،
  ومحرك الملاءمة ينقر داخله: ‎product.js‎ ينتظر المكوّن بـMutationObserver
  ويبحث عبر جذور الظل عن العنصر الذي يحمل معرّف المقاس، ويقرأ بيانات
  الخيارات من وسم JSON ادناه لا من النص المرئي.

  ‼ سمة ‎options‎ شرط للرندر: المكوّن عارض لا جالب، وبدونها يرندر صفرا.
#}
{% if product.options|length %}
    <salla-product-options data-testid="store-product-options" options="{{ product.options }}" product-id="{{ product.id }}"></salla-product-options>

    {# البيانات نفسها لمحرك الملاءمة: مطابقة على القيم لا على النص المرئي #}
    <script type="application/json" data-bs-options>{{ product.options|json_encode|raw }}</script>
{% endif %}

{% if product.has_bundle_products %}
    <salla-multiple-bundle-product bundle-sections='{{ product|json_encode }}'></salla-multiple-bundle-product>
{% endif %}
