{% extends "layouts.master" %}

{% block content %}
<section class="bs-article bs-pad" data-testid="store-thank-you">
    <header class="bs-article__head">
        <p class="bs-eyebrow">{{ store.name }}</p>
        <h1 class="bs-article__title">{{ page.title }}</h1>
