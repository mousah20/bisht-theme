{#
  بشت — القالب الرئيسي.
  ما يجب ان يبقى كما هو: خطافات سلة (hook) ومكوناتها في اسفل الجسم.
  ما هو من عندنا: الرأس العائم، الدرج، الستارة، والشرفة السفلى.
  الاعدادات تُقرأ مرة واحدة هنا وتُبَثّ على ‎#app‎ فلا يتكرر ‎theme.settings.get‎.
#}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0F1116">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    {#
      ‼ سلة لا تُدخل اصول الثيم تلقائيا: القالب هو من يربطها.
        قالب بلا هذا الوسم يظهر نصا خاما بلا اي خطأ في الطرفية.
    #}
    <link rel="stylesheet" href="{{ 'app.css'|asset }}">
    {# theme.font.path رابط كامل اصلا: تمريره على |cdn يضاعف المسار فيسقط الملف #}
    <link rel="stylesheet" href="{{ theme.font.url }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>

    <script defer src="{{ 'app.js'|asset }}"></script>
    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>

    {#
      لوحتا «الخطوط» و«الالوان» عند التاجر تكتبان في theme.font و theme.color،
      ولا تصلان الى الانماط الا اذا صرّحنا بها هنا. نظام بشت يقرأها
      عبر ‎--font-main/--font-secondary/--color-primary‎ ثم يعود لبدائله.
    #}
    <style>
        :root {
            --font-main: '{{ theme.font.name }}';
            {# خط العرض هوية الثيم فلا يُلغى بخط التاجر؛ خط التاجر يقود واجهة الاستعمال #}
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
            --color-main: {{ theme.color.primary }};
        }
    </style>

    {% block head_scripts %}{% endblock %}

    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}

    {# ــــ الاعدادات: قراءة واحدة ــــ #}
    {% set bs_curtain   = theme.settings.get('bs_curtain_enabled', true) %}
    {% set bs_cloth     = theme.settings.get('bs_cloth_image') %}
    {% set bs_dock      = theme.settings.get('bs_mobile_dock', true) %}

    {% if bs_cloth %}
        <style>#app{--bs-cloth:url('{{ bs_cloth }}')}</style>
    {% endif %}

    {% hook 'head:end' %}
</head>

<body id="app"
      class="bs-theme {% hook 'body:classes' %}"
      data-curtain-on="{{ bs_curtain ? '1' : '0' }}"
      data-dock-on="{{ bs_dock ? '1' : '0' }}">

{% hook 'body:start' %}

{% block header %}
    {% include 'components.header' %}
{% endblock %}

{% block content %}{% endblock %}

{% block footer %}
    {% include 'components.footer' %}
{% endblock %}

{% hook 'body:end' %}

{# مكونات سلة الالزامية — لا تُبنى ولا تُستبدل #}
<salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
<salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
<salla-search data-testid="store-search-modal"></salla-search>
<salla-login-modal data-testid="store-login-modal"></salla-login-modal>
<salla-scopes data-testid="store-scopes"
              selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
</body>
</html>
