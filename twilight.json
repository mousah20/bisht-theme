            "value": null,
            "required": false
        },
        {
            "id": "bs_cloth_image",
            "type": "string",
            "format": "image",
            "icon": "sicon-image",
            "label": {
                "ar": "قماش الستارة",
                "en": "Curtain cloth"
            },
            "description": {
                "ar": "صورة قماش بشت بحاشية قصب في اسفلها. تُقطع على سبع ثنيات فتنزل كثوب واحد بين الصفحات.",
                "en": "A photo of bisht cloth with the qasab hem near the bottom. It is sliced across seven folds and falls as one garment between pages."
            },
            "value": null,
            "required": false
        },
        {
            "id": "bs_curtain_enabled",
            "type": "boolean",
            "label": {
                "ar": "ستارة الانتقال",
                "en": "Curtain transition"
            },
            "description": {
                "ar": "تُسدل اثناء تحميل الصفحة فتغطي زمنه. تُعطل تلقائيا لمن يطلب تقليل الحركة من نظامه.",
                "en": "Falls during the actual page load so it covers the wait. Automatically disabled for visitors who ask for reduced motion."
            },
            "value": true,
            "required": false
        },
        {
            "id": "bs_size_guide_enabled",
            "type": "boolean",
            "label": {
                "ar": "حاسبة القياس في صفحة المنتج",
                "en": "Size calculator on the product page"
            },
            "description": {
                "ar": "ثلاث خطوات تحول القامة والبنية والاستعمال الى مقاس واحد بالطول والكتف.",
                "en": "Three steps that turn height, build and use into one length and shoulder size."
            },
            "value": true,
            "required": false
        },
        {
            "id": "bs_fit_note",
            "type": "string",
            "format": "textarea",
            "label": {
                "ar": "ملاحظة القياس",
                "en": "Fit note"
            },
            "description": {
                "ar": "تظهر تحت نتيجة الحاسبة. اكتب قاعدتك انت ان كانت تختلف — الافتراضي ان البشت يقف عن الكعب.",
                "en": "Shown under the calculator result. Write your own rule if it differs. The default is that the bisht stops at the heel."
            },
            "value": "المقاس يقف عن الكعب ولا يمس الارض. التعديل مجاني مرة واحدة.",
            "required": false
        },
        {
            "id": "bs_mobile_dock",
            "type": "boolean",
            "label": {
                "ar": "شرفة الشراء على الجوال",
                "en": "Mobile buy dock"
            },
            "description": {
                "ar": "شريط سفلي ثابت بالسعر وزر الاضافة، يظهر بعد ان يمرر الزائر عن الزر الاصلي.",
                "en": "A fixed bottom bar with the price and add button, shown after the visitor scrolls past the original button."
            },
            "value": true,
            "required": false
        },
        {
            "id": "bs_occasions_enabled",
            "type": "boolean",
            "label": {
                "ar": "التصفح بالمناسبة",
                "en": "Browse by occasion"
            },
            "description": {
                "ar": "شريط مناسبات في الرئيسية: عيد ورسمي ويومي. اربط كل مناسبة بتصنيف من قائمة متجرك.",
                "en": "An occasions strip on the home page. Link each occasion to a category from your store menu."
            },
            "value": true,
            "required": false
        },
        {
            "id": "bs_gift_enabled",
            "type": "boolean",
            "label": {
                "ar": "خيار الاهداء",
                "en": "Gift option"
            },
            "description": {
                "ar": "يظهر تنبيه التغليف والبطاقة في صفحة المنتج والسلة. نصف بشوت العيد هدايا.",
                "en": "Shows the wrapping and card note on the product page and cart. Half of holiday bishts are gifts."
            },
            "value": true,
            "required": false
        }
